# Private server configuration. Copy to .deploy.env (Git ignored).
# Example paths: replace USER with the dedicated FlakFlak system user.
DEPLOY_ROOT=/srv/users/USER/flakflak-deploy
DEPLOY_BRANCH=main
PHP_BIN=/opt/sp/php8.2/bin/php
COMPOSER_BIN=/opt/sp/bin/composer.phar
API_PUBLIC=/srv/users/USER/apps/flakflak-api/public
APP_PUBLIC=/srv/users/USER/apps/flakflak-app/public
EMBED_PUBLIC=/srv/users/USER/apps/flakflak-embed/public
API_HEALTH_URL=https://api.flakflak.com/api/v1/health
APP_HEALTH_URL=https://app.flakflak.com/
VITE_API_URL=https://api.flakflak.com/api/v1
VITE_EMBED_URL=https://embed.flakflak.com/widget.js
VITE_DASHBOARD_URL=https://app.flakflak.com
# Supply a working backup command/script, including database and attachment backups.
# The deployment stops if this command fails. Leave blank until configured.
BACKUP_COMMAND=
