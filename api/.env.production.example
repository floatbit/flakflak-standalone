APP_NAME=FlakFlak
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.flakflak.com
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flakflak
DB_USERNAME=flakflak
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
FLAKFLAK_DASHBOARD_ORIGIN=https://app.flakflak.com
FLAKFLAK_EMBED_URL=https://embed.flakflak.com/widget.js

# Configure a real mail service before enabling email sign-in in production.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@flakflak.com
MAIL_FROM_NAME=FlakFlak
